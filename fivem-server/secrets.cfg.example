# ================================================================
#  Copie ce fichier sous le nom « secrets.cfg » puis remplis-le.
#  secrets.cfg n'est jamais envoyé sur GitHub : ne le partage pas.
# ================================================================

# Clé de licence (gratuite) : https://portal.cfx.re
# -> connecte-toi avec ton compte Cfx.re, « Server Registration Keys », « Generate key »
sv_licenseKey "colle_ta_cle_ici"

# Clé Steam Web API (facultative). "none" = pas de Steam.
set steam_webApiKey "none"

# Admins : connecte-toi au serveur, tape /monid dans le chat,
# puis colle ici la ligne qu'il te donne (une ligne par admin) :
#add_principal identifier.license:0123456789abcdef0123456789abcdef01234567 group.admin
